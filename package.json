{
  "name": "nanokvm-usb",
  "private": true,
  "version": "1.2.0",
  "description": "NanoKVM-USB desktop and browser applications",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @nanokvm/desktop dev",
    "dev:browser": "pnpm --filter @nanokvm/browser dev",
    "build": "pnpm --filter @nanokvm/browser build && pnpm --filter @nanokvm/desktop build",
    "build:browser": "pnpm --filter @nanokvm/browser build",
    "build:desktop": "pnpm --filter @nanokvm/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
